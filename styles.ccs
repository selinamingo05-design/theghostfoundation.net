:root {
  --purple: #7658c9;
  --purple-dark: #4f3a8a;
  --purple-light: #a88de0;
  --purple-soft: #eee8fb;
  --off-white: #faf8fd;
  --white: #ffffff;
  --charcoal: #2b2930;
  --gray: #6f6b78;
  --border: #ddd6ea;
  --shadow: 0 14px 40px rgba(55, 40, 88, 0.08);
  --radius: 18px;
  --max-width: 1180px;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  font-family: Arial, Helvetica, sans-serif;
  color: var(--charcoal);
  background: var(--white);
  line-height: 1.65;
}

a {
  color: inherit;
}

img {
  max-width: 100%;
  display: block;
}

.container {
  width: min(92%, var(--max-width));
  margin: 0 auto;
}

.narrow {
  max-width: 820px;
}

.section {
  padding: 90px 0;
}

.section-light {
  background: var(--off-white);
}

.section-soft {
  background: var(--purple-soft);
}

.section-purple {
  background: linear-gradient(
    135deg,
    var(--purple-dark),
    var(--purple)
  );
  color: var(--white);
}

.section-label,
.eyebrow,
.small-label {
  text-transform: uppercase;
  letter-spacing: 0.11em;
  font-size: 0.78rem;
  font-weight: 700;
  color: var(--purple);
}

.light-label {
  color: #ddd0ff;
}

h1,
h2,
h3 {
  line-height: 1.15;
  margin-top: 0;
}

h1 {
  font-size: clamp(3.2rem, 8vw, 6.5rem);
  margin-bottom: 18px;
  letter-spacing: -0.045em;
}

h2 {
  font-size: clamp(2rem, 4vw, 3.25rem);
  margin-bottom: 24px;
  letter-spacing: -0.025em;
}

h3 {
  font-size: 1.28rem;
  margin-bottom: 12px;
}

p {
  margin-top: 0;
  margin-bottom: 18px;
}

.large-text {
  font-size: 1.18rem;
}

.site-header {
  position: sticky;
  top: 0;
  z-index: 100;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(12px);
  border-bottom: 1px solid rgba(79, 58, 138, 0.1);
}

.nav-wrapper {
  min-height: 78px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 28px;
}

.brand {
  display: flex;
  flex-direction: column;
  text-decoration: none;
}

.brand-name {
  font-weight: 800;
  font-size: 1.05rem;
}

.brand-tagline {
  color: var(--purple);
  font-size: 0.78rem;
  font-weight: 700;
}

.main-nav {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: flex-end;
  gap: 22px;
}

.main-nav a {
  text-decoration: none;
  font-size: 0.92rem;
  font-weight: 600;
  color: var(--charcoal);
}

.main-nav a:hover {
  color: var(--purple);
}

.hero {
  min-height: 78vh;
  display: flex;
  align-items: center;
  background:
    radial-gradient(circle at top right, rgba(168, 141, 224, 0.28), transparent 34%),
    linear-gradient(180deg, #fbf9ff 0%, #ffffff 100%);
  padding: 110px 0;
}

.hero-content {
  max-width: 950px;
}

.hero-subtitle {
  font-size: clamp(1.35rem, 3vw, 2rem);
  font-weight: 700;
  color: var(--purple-dark);
  max-width: 800px;
}

.hero-description {
  font-size: 1.08rem;
  max-width: 760px;
  color: var(--gray);
}

.button-group {
  display: flex;
  flex-wrap: wrap;
  gap: 14px;
  margin-top: 30px;
}

.button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 14px 22px;
  border-radius: 999px;
  font-weight: 700;
  text-decoration: none;
  transition: 0.2s ease;
}

.button:hover {
  transform: translateY(-2px);
}

.button-primary {
  background: var(--purple);
  color: var(--white);
  box-shadow: 0 10px 26px rgba(118, 88, 201, 0.25);
}

.button-primary:hover {
  background: var(--purple-dark);
}

.button-secondary {
  background: var(--white);
  color: var(--purple-dark);
  border: 1px solid var(--border);
}

.button-outline {
  background: transparent;
  color: var(--purple-dark);
  border: 2px solid var(--purple);
}

.card-grid,
.audience-grid,
.spotlight-actions {
  display: grid;
  gap: 22px;
}

.card-grid {
  grid-template-columns: repeat(3, 1fr);
  margin-top: 42px;
}

.service-card,
.audience-card,
.action-card,
.feature-box,
.spotlight-card {
  border: 1px solid var(--border);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
}

.service-card {
  padding: 28px;
  background: var(--white);
}

.service-card h3 {
  color: var(--purple-dark);
}

.two-column {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 60px;
  align-items: start;
}

.values-list {
  display: grid;
  gap: 18px;
}

.value-item {
  padding-bottom: 18px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.2);
}

.value-item:last-child {
  border-bottom: 0;
}

.audience-grid {
  grid-template-columns: repeat(3, 1fr);
  margin-top: 36px;
}

.audience-card {
  background: var(--off-white);
  padding: 25px;
}

.audience-card h3 {
  margin: 0;
  color: var(--purple-dark);
}

.feature-box {
  background: var(--white);
  padding: 30px;
}

.feature-box ul {
  padding-left: 22px;
  margin-bottom: 0;
}

.feature-box li {
  margin-bottom: 9px;
}

.text-link {
  font-weight: 700;
  color: var(--purple);
  text-decoration: none;
}

.text-link:hover {
  text-decoration: underline;
}

.spotlight-section {
  background: var(--white);
}

.spotlight-intro {
  max-width: 760px;
  font-size: 1.08rem;
  color: var(--gray);
}

.spotlight-card {
  margin-top: 38px;
  display: grid;
  grid-template-columns: 0.8fr 1.2fr;
  overflow: hidden;
  background: var(--white);
}

.spotlight-placeholder {
  min-height: 280px;
  display: flex;
  justify-content: center;
  align-items: center;
  text-align: center;
  padding: 30px;
  background:
    linear-gradient(
      145deg,
      var(--purple-dark),
      var(--purple-light)
    );
  color: var(--white);
  font-weight: 800;
  font-size: 1.4rem;
}

.spotlight-content {
  padding: 38px;
}

.spotlight-actions {
  grid-template-columns: 1fr 1fr;
  margin-top: 28px;
}

.action-card {
  padding: 30px;
  background: var(--off-white);
}

.final-cta {
  text-align: center;
  background:
    radial-gradient(circle at center top, rgba(168, 141, 224, 0.24), transparent 40%),
    var(--off-white);
}

.site-footer {
  background: var(--charcoal);
  color: var(--white);
  padding: 44px 0;
}

.footer-content {
  display: flex;
  justify-content: space-between;
  gap: 30px;
  align-items: flex-start;
}

.footer-content p {
  color: #d4d0db;
  margin-bottom: 0;
}

@media (max-width: 950px) {
  .nav-wrapper {
    align-items: flex-start;
    padding: 18px 0;
  }

  .main-nav {
    gap: 14px;
  }

  .card-grid,
  .audience-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .two-column {
    gap: 35px;
  }
}

@media (max-width: 720px) {
  .section {
    padding: 65px 0;
  }

  .nav-wrapper {
    flex-direction: column;
  }

  .main-nav {
    justify-content: flex-start;
  }

  .hero {
    min-height: auto;
    padding: 85px 0;
  }

  .card-grid,
  .audience-grid,
  .two-column,
  .spotlight-card,
  .spotlight-actions {
    grid-template-columns: 1fr;
  }

  .spotlight-placeholder {
    min-height: 200px;
  }

  .footer-content {
    flex-direction: column;
  }
}
